# ── Gemini LLM (required) ─────────────────────────────────────────────────────
# Obtain from https://aistudio.google.com/app/apikey
# Note: gemini-3.8-flash has a free tier; verify current limits in Google AI Studio.
# Production workloads require a paid Google Cloud project with billing enabled.
GOOGLE_API_KEY=your_google_api_key_here

# Override the Gemini model (optional; defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.7-flash

# ── Sarvam AI — Hinglish transcription (required for Hinglish) ────────────────
# Obtain from https://www.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here

# ── Backend (optional) ────────────────────────────────────────────────────────
# Comma-separated CORS origins allowed by the API (default: localhost:3000)
VIDEXA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Maximum upload size in megabytes (default: 2048)
VIDEXA_MAX_MEDIA_SIZE_MB=2048
